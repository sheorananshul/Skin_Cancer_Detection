# ----------------------- Check for Missing Data -----------------------
def check_for_missing_data(df):
    summary = pd.DataFrame(df.dtypes, columns=['dtypes'])
    summary = summary.reset_index()
    summary['Name'] = summary['index']
    summary = summary[['Name', 'dtypes']]
    summary['Missing'] = df.isnull().sum().values
    return summary

print(check_for_missing_data(skin_df))

# Fill missing age with mean and convert to integer
skin_df['age'].fillna(skin_df['age'].mean(), inplace=True)

def convert_float_to_int(df, column_name):
    if df[column_name].dtype == 'float64':
        df[column_name] = df[column_name].astype(int)
    return df

skin_df = convert_float_to_int(skin_df, 'age')
skin_df.info()

# ----------------------- Duplicate & Null Checks -----------------------
def check_for_duplicate_rows(df):
    size = df.shape
    sum_duplicates = df.duplicated().sum()
    sum_null = df.isnull().sum()
    print("Number of Samples:", size[0])
    print("Duplicated Entries:", sum_duplicates)
    print("Null Entries:\n", sum_null)

check_for_duplicate_rows(skin_df)

# Remove duplicate lesion samples
lesion_id_cnt = skin_df['lesion_id'].value_counts()

def check_duplicates_lesions(lesion_id):
    return lesion_id_cnt[lesion_id] > 1

skin_df['dup_les'] = skin_df['lesion_id'].map(check_duplicates_lesions)
print(skin_df['dup_les'].value_counts())
skin_df = skin_df[skin_df.dup_les == False]
